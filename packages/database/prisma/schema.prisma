// SmrkoMed — multi-tenant fertility clinic schema (Phase 1 foundation)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum StaffRole {
  CLINIC_ADMIN
  DOCTOR
  CARE_COORDINATOR
  NURSE
  RECEPTIONIST
  PLATFORM_ADMIN
  ORGANIZATION_ADMIN
  COUNSELOR
  MARKETING
  READ_ONLY
  PHARMACY_MANAGER
  PHARMACIST
  PHARMACY_STAFF
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CoupleStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum CarePlanType {
  FERTILITY_EVALUATION
  IUI
  IVF
  FET
}

enum CarePlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CarePlanStepStatus {
  PENDING
  CURRENT
  DONE
  SKIPPED
}

enum CareTaskStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  ESCALATED
  CANCELLED
}

enum CareTaskPriority {
  LOW
  NORMAL
  HIGH
  CLINICAL
}

enum TreatmentKind {
  IVF
  IUI
  EVALUATION
  FET
}

enum CycleStatus {
  ACTIVE
  NEEDS_ATTENTION
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  CONFIRMED
  WAITING
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum ConversationChannel {
  WHATSAPP
  VOICE
  SMS
  EMAIL
}

enum ConversationStatus {
  OPEN
  WAITING_PATIENT
  WAITING_STAFF
  HUMAN_HANDOFF
  ESCALATED
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  PATIENT
  STAFF
  AI
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppTemplateStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
  PAUSED
}

enum EscalationType {
  CLINICAL
  NO_RESPONSE
  MISSING_REPORT
  APPOINTMENT
  TASK_OVERDUE
  AI_UNABLE_TO_RESOLVE
}

enum EscalationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum DocumentStatus {
  AWAITING_UPLOAD
  UPLOADED
  DOCTOR_REVIEW
  REVIEWED
  REJECTED
}

enum ConsentChannel {
  WHATSAPP
  VOICE
  SMS
  EMAIL
}

enum ConsentType {
  WHATSAPP_COMMUNICATION
  VOICE_COMMUNICATION
  MARKETING
}

enum ConsentStatus {
  GRANTED
  REVOKED
  PENDING
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum IntegrationProvider {
  WHATSAPP_CLOUD
  META_ADS
  GOOGLE_ADS
  GOOGLE_CALENDAR
  RAZORPAY
  SMS
  EMAIL
  VOICE
  EMR
  ABDM
  OPENAI
  S3
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
  ERROR
  ACTION_REQUIRED
  PENDING
  DISCONNECTED
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum ModuleKey {
  CARE_LOOP
  CRM
  APPOINTMENTS
  ANALYTICS
  BILLING
  MARKETING
  VOICE
}

enum SubscriptionPlanKey {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum LeadSource {
  META
  GOOGLE
  META_ADS
  GOOGLE_ADS
  WEBSITE
  WHATSAPP
  PHONE
  REFERRAL
  WALK_IN
  INSTAGRAM
  FACEBOOK
  ORGANIC
  OTHER
  CAMPAIGN
}

enum LeadStatus {
  NEW
  OPEN
  CONVERTED
  LOST
  ARCHIVED
  CONTACTED
  QUALIFIED
  CONSULTATION_BOOKED
  CONSULTATION_COMPLETED
  TREATMENT_DISCUSSION
  TREATMENT_STARTED
  ACTIVE_PATIENT
}

enum LeadStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  CONSULTATION_BOOKED
  CONSULTATION_COMPLETED
  INVESTIGATION
  TREATMENT_DISCUSSION
  TREATMENT_STARTED
  ACTIVE_PATIENT
  LOST
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum LeadActivityType {
  LEAD_CREATED
  LEAD_ASSIGNED
  LEAD_REASSIGNED
  CALL_ATTEMPTED
  CALL_CONNECTED
  WHATSAPP_SENT
  WHATSAPP_RECEIVED
  COUNSELLING_COMPLETED
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  STAGE_CHANGED
  NOTE_ADDED
  FOLLOW_UP_SCHEDULED
  LEAD_CONVERTED
  LEAD_LOST
  LEAD_REOPENED
  SCORE_UPDATED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model Organization {
  id                    String             @id @default(cuid())
  name                  String
  slug                  String?
  status                OrganizationStatus @default(ACTIVE)
  ownerUserId           String?
  trialEndsAt           DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  clinics               Clinic[]
  subscription          Subscription?
  modules               OrganizationModule[]
  leads                 Lead[]
  campaigns             Campaign[]
  leadActivities        LeadActivity[]
  staffInvites          StaffInvite[]
  auditLogs             AuditLog[]
  integrations          Integration[]
  integrationEvents     IntegrationEvent[]

  @@index([slug])
}

model Clinic {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  city           String?
  address        String?
  phone          String?
  email          String?
  website        String?
  timezone       String   @default("Asia/Kolkata")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branches     ClinicBranch[]
  memberships  ClinicMembership[]
  patients     Patient[]
  couples      Couple[]
  carePlanTemplates CarePlanTemplate[]
  carePlans    CarePlan[]
  careTasks    CareTask[]
  treatments   Treatment[]
  appointments Appointment[]
  conversations Conversation[]
  escalations  Escalation[]
  documents    Document[]
  documentCategories DocumentCategory[]
  consents     Consent[]
  notifications Notification[]
  auditLogs    AuditLog[]
  automationRules AutomationRule[]
  integrations Integration[]
  integrationEvents IntegrationEvent[]
  whatsappAccounts WhatsAppAccount[]
  whatsappTemplates WhatsAppTemplate[]
  leads        Lead[]
  campaigns    Campaign[]
  leadActivities LeadActivity[]
  consultationNotes ConsultationNote[]
  pharmacyProducts PharmacyProduct[]
  pharmacyBatches PharmacyBatch[]
  pharmacyStockMovements PharmacyStockMovement[]
  pharmacySuppliers PharmacySupplier[]
  pharmacyPurchaseOrders PharmacyPurchaseOrder[]
  pharmacySales PharmacySale[]
  pharmacyPrescriptions PharmacyPrescription[]
  pharmacySettings PharmacySetting?
  medicationReminders MedicationReminder[]
  insuranceProviders InsuranceProvider[]
  insuranceTpas InsuranceTpa[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims InsuranceClaim[]
  insuranceQueries InsuranceQuery[]
  insurancePayments InsurancePayment[]
  insuranceClaimEvents InsuranceClaimEvent[]
  paymentGatewayConnections PaymentGatewayConnection[]
  billingInvoices BillingInvoice[]
  billingPayments BillingPayment[]
  billingRefunds BillingRefund[]
  paymentWebhookEvents PaymentWebhookEvent[]
  whatsappFlows WhatsAppFlow[]
  whatsappFlowExecutions WhatsAppFlowExecution[]
  whatsappKnowledgeArticles WhatsAppKnowledgeArticle[]
  whatsappClinicSettings WhatsAppClinicSettings?
  communicationPreferences CommunicationPreference[]
  whatsappCampaigns WhatsAppCampaign[]
  digitalHealthIdentities DigitalHealthIdentity[]
  digitalHealthConsents DigitalHealthConsent[]
  healthRecordExchanges HealthRecordExchange[]

  @@index([organizationId])
}

model ClinicBranch {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  city      String?
  address   String?
  phone     String?
  hours     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  initials     String?
  title        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships ClinicMembership[]
  assignedTasks TaskAssignment[] @relation("AssignedTasks")
  createdTasks  CareTask[]       @relation("CreatedTasks")
  assignedEscalations Escalation[] @relation("EscalationAssignee")
  notifications Notification[]
  auditLogs     AuditLog[]       @relation("AuditActor")
  coordinatedCouples Couple[]    @relation("CoupleCoordinator")
  doctorCouples      Couple[]    @relation("CoupleDoctor")
  assignedLeads      Lead[]      @relation("LeadAssignee")
  leadActivities     LeadActivity[]
  consultationNotes  ConsultationNote[] @relation("ConsultationAuthor")
  pharmacyStockMovements PharmacyStockMovement[] @relation("PharmacyStockActor")
  pharmacySales          PharmacySale[]          @relation("PharmacySaleCreator")
  pharmacyPrescriptions  PharmacyPrescription[]  @relation("PharmacyPrescriptionDoctor")
  pharmacyDispenses      PharmacyPrescription[]  @relation("PharmacyPrescriptionDispenser")
  insuranceClaimsAssigned InsuranceClaim[] @relation("InsuranceClaimAssignee")
  insuranceQueriesAssigned InsuranceQuery[] @relation("InsuranceQueryAssignee")
  whatsappFlowsCreated WhatsAppFlow[] @relation("WhatsAppFlowCreator")
  whatsappKnowledgeArticles WhatsAppKnowledgeArticle[] @relation("WhatsAppKbAuthor")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  billingInvoicesCreated BillingInvoice[] @relation("BillingInvoiceCreator")
  billingPaymentsCreated BillingPayment[] @relation("BillingPaymentCreator")
  billingRefundsCreated BillingRefund[] @relation("BillingRefundCreator")
  whatsappCampaignsCreated WhatsAppCampaign[] @relation("WhatsAppCampaignCreator")
  digitalHealthConsentsRequested DigitalHealthConsent[] @relation("DigitalHealthConsentRequester")
  healthRecordExchangesCreated HealthRecordExchange[] @relation("HealthRecordExchangeCreator")
}

model Role {
  id          String    @id @default(cuid())
  key         StaffRole @unique
  name        String
  description String?
  permissions RolePermission[]
  memberships ClinicMembership[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ClinicMembership {
  id        String           @id @default(cuid())
  clinicId  String
  userId    String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([clinicId, userId])
  @@index([userId])
  @@index([clinicId])
}

// ─── Patients & couples ──────────────────────────────────────────────────────

model Patient {
  id              String        @id @default(cuid())
  clinicId        String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender        @default(UNSPECIFIED)
  phone           String?
  whatsappNumber  String?
  email           String?
  preferredLanguage String      @default("en")
  status          PatientStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  primaryCouples Couple[] @relation("PrimaryPatient")
  partnerCouples Couple[] @relation("PartnerPatient")
  conversations Conversation[]
  documents     Document[]
  consents      Consent[]
  escalations   Escalation[]
  convertedLeads Lead[]
  pharmacySales PharmacySale[]
  pharmacyPrescriptions PharmacyPrescription[]
  medicationReminders MedicationReminder[]
  insurancePolicies InsurancePolicy[]
  insuranceClaimsAsPatient InsuranceClaim[] @relation("InsuranceClaimPatient")
  billingInvoices BillingInvoice[]
  billingPayments BillingPayment[]
  communicationPreference CommunicationPreference?
  whatsappCampaignRecipients WhatsAppCampaignRecipient[]
  digitalHealthIdentity DigitalHealthIdentity?
  digitalHealthConsents DigitalHealthConsent[]
  healthRecordExchanges HealthRecordExchange[]

  @@index([clinicId])
  @@index([clinicId, whatsappNumber])
  @@index([clinicId, phone])
}

model Couple {
  id                    String       @id @default(cuid())
  clinicId              String
  slug                  String
  primaryPatientId      String
  partnerPatientId      String?
  status                CoupleStatus @default(ACTIVE)
  assignedCoordinatorId String?
  assignedDoctorId      String?
  careLoopActive        Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  clinic              Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  primaryPatient      Patient @relation("PrimaryPatient", fields: [primaryPatientId], references: [id])
  partnerPatient      Patient? @relation("PartnerPatient", fields: [partnerPatientId], references: [id])
  assignedCoordinator User?   @relation("CoupleCoordinator", fields: [assignedCoordinatorId], references: [id])
  assignedDoctor      User?   @relation("CoupleDoctor", fields: [assignedDoctorId], references: [id])
  carePlans           CarePlan[]
  careTasks           CareTask[]
  treatments          Treatment[]
  appointments        Appointment[]
  conversations       Conversation[]
  documents           Document[]
  escalations         Escalation[]
  convertedLeads      Lead[]
  consultationNotes   ConsultationNote[]
  pharmacySales       PharmacySale[]
  pharmacyPrescriptions PharmacyPrescription[]
  insurancePolicies   InsurancePolicy[]
  insuranceClaims     InsuranceClaim[]
  billingInvoices     BillingInvoice[]
  billingPayments     BillingPayment[]

  @@unique([clinicId, slug])
  @@index([clinicId])
  @@index([primaryPatientId])
}

// ─── Care plans & tasks ──────────────────────────────────────────────────────

model CarePlanTemplate {
  id          String       @id @default(cuid())
  clinicId    String
  type        CarePlanType
  name        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  steps  CarePlanTemplateStep[]
  plans  CarePlan[]

  @@index([clinicId])
}

model CarePlanTemplateStep {
  id         String @id @default(cuid())
  templateId String
  sortOrder  Int
  name       String
  description String?

  template CarePlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model CarePlan {
  id           String         @id @default(cuid())
  clinicId     String
  coupleId     String
  templateId   String?
  type         CarePlanType
  name         String
  status       CarePlanStatus @default(ACTIVE)
  startDate    DateTime?
  currentStep  Int            @default(0)
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  clinic   Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  couple   Couple            @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  template CarePlanTemplate? @relation(fields: [templateId], references: [id])
  steps    CarePlanStep[]
  tasks    CareTask[]
  treatments Treatment[]

  @@index([clinicId])
  @@index([coupleId])
}

model CarePlanStep {
  id         String             @id @default(cuid())
  carePlanId String
  sortOrder  Int
  name       String
  status     CarePlanStepStatus @default(PENDING)
  detail     String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  carePlan CarePlan   @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  tasks    CareTask[]

  @@index([carePlanId])
}

model CareTask {
  id                  String           @id @default(cuid())
  clinicId            String
  coupleId            String?
  leadId              String?
  carePlanId          String?
  carePlanStepId      String?
  title               String
  description         String?
  category            String?
  status              CareTaskStatus   @default(WAITING)
  priority            CareTaskPriority @default(NORMAL)
  dueDate             DateTime?
  dueTime             String?
  createdById         String?
  automationEnabled   Boolean          @default(true)
  aiFollowUpEnabled   Boolean          @default(true)
  voiceFollowUpEnabled Boolean         @default(false)
  escalationEnabled   Boolean          @default(true)
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  couple       Couple?       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  carePlan     CarePlan?     @relation(fields: [carePlanId], references: [id])
  carePlanStep CarePlanStep? @relation(fields: [carePlanStepId], references: [id])
  createdBy    User?         @relation("CreatedTasks", fields: [createdById], references: [id])
  reminders    TaskReminder[]
  assignments  TaskAssignment[]
  escalations  Escalation[]
  documents    Document[]
  aiInteractions AIInteraction[]
  medicationReminders MedicationReminder[]
  pharmacyPrescriptionItems PharmacyPrescriptionItem[]
  insuranceQueries InsuranceQuery[]

  @@index([clinicId, status])
  @@index([coupleId])
  @@index([leadId])
  @@index([dueDate])
}

model TaskReminder {
  id          String   @id @default(cuid())
  careTaskId  String
  remindAt    DateTime
  channel     ConversationChannel @default(WHATSAPP)
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  careTask CareTask @relation(fields: [careTaskId], references: [id], onDelete: Cascade)

  @@index([careTaskId])
  @@index([remindAt])
}

model TaskAssignment {
  id         String   @id @default(cuid())
  careTaskId String
  userId     String
  note       String?
  assignedAt DateTime @default(now())

  careTask CareTask @relation(fields: [careTaskId], references: [id], onDelete: Cascade)
  user     User     @relation("AssignedTasks", fields: [userId], references: [id])

  @@index([careTaskId])
  @@index([userId])
}

// ─── Treatments & appointments ───────────────────────────────────────────────

model Treatment {
  id         String        @id @default(cuid())
  clinicId   String
  coupleId   String
  carePlanId String?
  kind       TreatmentKind
  label      String
  status     CycleStatus   @default(ACTIVE)
  stageIndex Int           @default(0)
  stageName  String?
  startedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  couple   Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  carePlan CarePlan? @relation(fields: [carePlanId], references: [id])
  ivfCycle IVFCycle?
  iuiCycle IUICycle?
  pharmacyPrescriptions PharmacyPrescription[]

  @@index([clinicId])
  @@index([coupleId])
}

model IVFCycle {
  id          String @id @default(cuid())
  treatmentId String @unique
  cycleNumber Int    @default(1)
  notes       String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
}

model IUICycle {
  id          String @id @default(cuid())
  treatmentId String @unique
  cycleNumber Int    @default(1)
  notes       String?

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          String            @id @default(cuid())
  clinicId    String
  coupleId    String?
  leadId      String?
  type        String
  doctorName  String?
  room        String?
  startsAt    DateTime
  durationMin Int               @default(30)
  status      AppointmentStatus @default(CONFIRMED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  couple Couple? @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  pharmacyPrescriptions PharmacyPrescription[]

  @@index([clinicId, startsAt])
  @@index([coupleId])
  @@index([leadId])
}

// ─── Consultation notes (summary only — never store audio) ───────────────────

model ConsultationNote {
  id               String   @id @default(cuid())
  clinicId         String
  coupleId         String
  createdById      String?
  consultationDate DateTime @default(now())
  summary          String
  reasonForVisit   String?
  nextSteps        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  couple    Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ConsultationAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, consultationDate])
  @@index([coupleId, consultationDate])
}

// ─── Conversations & AI ──────────────────────────────────────────────────────

model Conversation {
  id               String              @id @default(cuid())
  clinicId         String
  coupleId         String?
  patientId        String?
  leadId           String?
  contactPhone     String?
  unmatched        Boolean             @default(false)
  channel          ConversationChannel @default(WHATSAPP)
  status           ConversationStatus  @default(OPEN)
  /// Staff owning this thread (clinic membership validated on assign)
  assignedStaffId  String?
  priority         String              @default("NORMAL")
  handoffAt        DateTime?
  handoffReason    String?
  /// When set, automation triggers for this patient conversation should stay paused
  automationPausedAt DateTime?
  lastStaffReadAt  DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  clinic         Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  couple         Couple? @relation(fields: [coupleId], references: [id])
  patient        Patient? @relation(fields: [patientId], references: [id])
  lead           Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedStaff  User?   @relation("ConversationAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages       Message[]
  aiInteractions AIInteraction[]

  @@index([clinicId, channel])
  @@index([patientId])
  @@index([coupleId])
  @@index([leadId])
  @@index([clinicId, contactPhone])
  @@index([clinicId, assignedStaffId])
  @@index([clinicId, status])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  senderType        MessageSenderType
  content           String
  messageType       String           @default("text")
  providerMessageId String?
  status            MessageStatus    @default(QUEUED)
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiInteractions AIInteraction[]

  @@index([conversationId, createdAt])
  @@unique([providerMessageId])
}

model AIInteraction {
  id             String   @id @default(cuid())
  conversationId String?
  messageId      String?
  careTaskId     String?
  intent         String?
  classification String?
  model          String?
  safeToAutoReply Boolean @default(false)
  rawSummary     String?
  createdAt      DateTime @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id])
  message      Message?      @relation(fields: [messageId], references: [id])
  careTask     CareTask?     @relation(fields: [careTaskId], references: [id])

  @@index([careTaskId])
}

// ─── Escalations ─────────────────────────────────────────────────────────────

model Escalation {
  id           String             @id @default(cuid())
  clinicId     String
  coupleId     String?
  patientId    String?
  careTaskId   String?
  type         EscalationType
  severity     EscalationSeverity @default(MEDIUM)
  reason       String
  assignedToId String?
  status       EscalationStatus   @default(OPEN)
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  updatedAt    DateTime           @updatedAt

  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  couple     Couple?   @relation(fields: [coupleId], references: [id])
  patient    Patient?  @relation(fields: [patientId], references: [id])
  careTask   CareTask? @relation(fields: [careTaskId], references: [id])
  assignedTo User?     @relation("EscalationAssignee", fields: [assignedToId], references: [id])

  @@index([clinicId, status])
  @@index([careTaskId])
}

// ─── Documents ───────────────────────────────────────────────────────────────

model DocumentCategory {
  id       String @id @default(cuid())
  clinicId String
  key      String
  name     String

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([clinicId, key])
}

model Document {
  id           String         @id @default(cuid())
  clinicId     String
  patientId    String?
  coupleId     String?
  careTaskId   String?
  categoryId   String?
  name         String
  storageKey   String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  status       DocumentStatus @default(AWAITING_UPLOAD)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  clinic   Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient  Patient?          @relation(fields: [patientId], references: [id])
  couple   Couple?           @relation(fields: [coupleId], references: [id])
  careTask CareTask?         @relation(fields: [careTaskId], references: [id])
  category DocumentCategory? @relation(fields: [categoryId], references: [id])
  insuranceClaimDocuments InsuranceClaimDocument[]
  insurancePoliciesAsCard InsurancePolicy[] @relation("InsuranceCardDocument")

  @@index([clinicId])
  @@index([coupleId])
}

// ─── Consent, notifications, audit ───────────────────────────────────────────

model Consent {
  id          String         @id @default(cuid())
  clinicId    String
  patientId   String
  channel     ConsentChannel
  consentType ConsentType
  status      ConsentStatus  @default(PENDING)
  consentedAt DateTime?
  source      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, consentType, channel])
  @@index([clinicId])
}

model Notification {
  id        String             @id @default(cuid())
  clinicId  String
  userId    String
  title     String
  body      String?
  status    NotificationStatus @default(UNREAD)
  href      String?
  createdAt DateTime           @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([clinicId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  clinicId       String?
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([clinicId, createdAt])
  @@index([entityType, entityId])
}

model AutomationRule {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  isActive  Boolean  @default(true)
  trigger   String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model Integration {
  id                   String              @id @default(cuid())
  organizationId       String
  clinicId             String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(DISABLED)
  config               Json?
  displayName          String?
  externalAccountId    String?
  encryptedCredentials String?
  expiresAt            DateTime?
  lastError            String?
  lastErrorCode        String?
  lastSyncAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  events       IntegrationEvent[]
  whatsappAccounts WhatsAppAccount[]
  whatsappTemplates WhatsAppTemplate[]

  @@unique([clinicId, provider])
  @@index([organizationId, provider])
}

model IntegrationEvent {
  id               String                  @id @default(cuid())
  integrationId    String?
  organizationId   String
  clinicId         String
  provider         IntegrationProvider
  externalEventId  String
  eventType        String
  status           IntegrationEventStatus  @default(RECEIVED)
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?
  error            String?
  metadata         Json?
  encryptedPayload String?
  payloadExpiresAt DateTime?

  integration  Integration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([organizationId, receivedAt])
  @@index([clinicId, receivedAt])
  @@index([status, receivedAt])
  @@index([integrationId])
}

model Subscription {
  id               String               @id @default(cuid())
  organizationId   String               @unique
  plan             SubscriptionPlanKey  @default(STARTER)
  status           SubscriptionStatus   @default(TRIALING)
  trialEndsAt      DateTime
  currentPeriodEnd DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationModule {
  organizationId String
  module         ModuleKey
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, module])
}

model Lead {
  id                 String      @id @default(cuid())
  organizationId     String
  clinicId           String?
  name               String
  phone              String?
  email              String?
  preferredLanguage  String?
  source             LeadSource
  sourceDetail       String?
  campaign           String?
  campaignId         String?
  ad                 String?
  medium             String?
  externalLeadId     String?
  landingPage        String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  location           String?
  treatmentInterest  String?
  assignedToId       String?
  status             LeadStatus  @default(NEW)
  stage              LeadStage   @default(NEW_LEAD)
  score              Int         @default(0)
  nextFollowUpAt     DateTime?
  lastActivityAt     DateTime?
  lostReason         String?
  convertedAt        DateTime?
  patientId          String?
  coupleId           String?
  conversationId     String?
  metadata           Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  campaignRecord Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  couple       Couple?      @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  activities   LeadActivity[]
  careTasks    CareTask[]
  appointments Appointment[]
  conversations Conversation[]

  @@index([organizationId, status])
  @@index([organizationId, stage])
  @@index([clinicId, stage])
  @@index([clinicId, source])
  @@index([assignedToId])
  @@index([campaignId])
  @@index([createdAt])
  @@index([clinicId, phone])
  @@index([clinicId, email])
  @@index([nextFollowUpAt])
}

model Campaign {
  id                  String         @id @default(cuid())
  organizationId      String
  clinicId            String?
  name                String
  source              LeadSource
  medium              String?
  campaignExternalId  String?
  treatmentFocus      String?
  status              CampaignStatus @default(DRAFT)
  startDate           DateTime?
  endDate             DateTime?
  budget              Decimal?       @db.Decimal(12, 2)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  leads        Lead[]

  @@index([organizationId, status])
  @@index([clinicId])
  @@index([source])
}

model LeadActivity {
  id             String           @id @default(cuid())
  leadId         String
  organizationId String
  clinicId       String?
  userId         String?
  type           LeadActivityType
  description    String
  metadata       Json?
  createdAt      DateTime         @default(now())

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic       Clinic?      @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([clinicId, createdAt])
}

model StaffInvite {
  id             String           @id @default(cuid())
  organizationId String
  clinicId       String?
  email          String
  name           String
  role           StaffRole
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model WhatsAppAccount {
  id                  String   @id @default(cuid())
  clinicId            String
  integrationId       String?
  phoneNumberId       String
  displayPhoneNumber  String?
  displayName         String?
  verifiedName        String?
  businessAccountId   String?
  qualityRating       String?
  isActive            Boolean  @default(true)
  lastSyncedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([clinicId, phoneNumberId])
  @@index([clinicId])
  @@index([phoneNumberId])
  @@index([businessAccountId])
}

model WhatsAppTemplate {
  id               String                 @id @default(cuid())
  clinicId         String
  integrationId    String
  externalId       String?
  name             String
  language         String
  category         String
  status           WhatsAppTemplateStatus
  parameterCount   Int                    @default(0)
  rejectionReason  String?
  lastSyncedAt     DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, name, language])
  @@index([clinicId, status])
}

model IntegrationOauthState {
  id             String               @id @default(cuid())
  provider       IntegrationProvider
  userId         String
  organizationId String
  clinicId       String
  nonce          String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime             @default(now())

  @@index([expiresAt])
  @@index([clinicId, provider])
}

// ─── Pharmacy ────────────────────────────────────────────────────────────────

enum PharmacyProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PharmacySupplierStatus {
  ACTIVE
  INACTIVE
}

enum PharmacyStockMovementType {
  PURCHASE
  SALE
  DISPENSE
  ADJUSTMENT
  DAMAGED
  EXPIRED
  RETURNED
  TRANSFER_IN
  TRANSFER_OUT
}

enum PharmacyPurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PharmacySalePaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum PharmacySalePaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

enum PharmacyPrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum MedicationReminderStatus {
  PENDING
  SCHEDULED
  DUE
  TAKEN
  MISSED
  SKIPPED
  COMPLETED
  SENT
  DELIVERED
  FAILED
  CANCELLED
  SKIPPED_NO_CONSENT
}

model PharmacySetting {
  id                String   @id @default(cuid())
  clinicId          String   @unique
  expiryWarningDays Int      @default(30)
  lowStockEnabled   Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model PharmacyProduct {
  id                   String                @id @default(cuid())
  clinicId             String
  name                 String
  genericName          String?
  brandName            String?
  category             String?
  subCategory          String?
  description          String?
  manufacturer         String?
  unit                 String                @default("unit")
  packSize             String?
  medicineType         String?
  imageUrl             String?
  prescriptionRequired Boolean               @default(false)
  minimumStock         Int                   @default(0)
  reorderLevel         Int                   @default(0)
  defaultPurchasePrice Decimal               @default(0) @db.Decimal(12, 2)
  defaultSellingPrice  Decimal               @default(0) @db.Decimal(12, 2)
  defaultMrp           Decimal               @default(0) @db.Decimal(12, 2)
  gstPercent           Decimal               @default(0) @db.Decimal(5, 2)
  status               PharmacyProductStatus @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  clinic            Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  batches           PharmacyBatch[]
  stockMovements    PharmacyStockMovement[]
  purchaseItems     PharmacyPurchaseOrderItem[]
  saleItems         PharmacySaleItem[]
  prescriptionItems PharmacyPrescriptionItem[]

  @@index([clinicId])
  @@index([clinicId, status])
  @@index([clinicId, category])
  @@index([clinicId, manufacturer])
  @@index([clinicId, name])
}

model PharmacySupplier {
  id            String                 @id @default(cuid())
  clinicId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  licenseInfo   String?
  notes         String?
  status        PharmacySupplierStatus @default(ACTIVE)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  clinic         Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  batches        PharmacyBatch[]
  purchaseOrders PharmacyPurchaseOrder[]

  @@index([clinicId])
  @@index([clinicId, status])
  @@index([clinicId, name])
}

model PharmacyBatch {
  id                String    @id @default(cuid())
  clinicId          String
  productId         String
  supplierId        String?
  batchNumber       String
  quantity          Int       @default(0)
  availableQuantity Int       @default(0)
  reservedQuantity  Int       @default(0)
  purchasePrice     Decimal   @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal   @default(0) @db.Decimal(12, 2)
  mrp               Decimal   @default(0) @db.Decimal(12, 2)
  gstPercent        Decimal   @default(0) @db.Decimal(5, 2)
  manufacturingDate DateTime?
  expiryDate        DateTime?
  purchaseDate      DateTime?
  storageLocation   String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clinic            Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  product           PharmacyProduct             @relation(fields: [productId], references: [id])
  supplier          PharmacySupplier?           @relation(fields: [supplierId], references: [id])
  stockMovements    PharmacyStockMovement[]
  saleItems         PharmacySaleItem[]
  purchaseItems     PharmacyPurchaseOrderItem[]
  prescriptionItems PharmacyPrescriptionItem[]

  @@unique([clinicId, productId, batchNumber])
  @@index([clinicId])
  @@index([clinicId, productId])
  @@index([clinicId, expiryDate])
  @@index([supplierId])
}

model PharmacyStockMovement {
  id            String                    @id @default(cuid())
  clinicId      String
  productId     String
  batchId       String
  type          PharmacyStockMovementType
  quantity      Int
  balanceAfter  Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorUserId   String?
  createdAt     DateTime                  @default(now())

  clinic  Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  product PharmacyProduct @relation(fields: [productId], references: [id])
  batch   PharmacyBatch   @relation(fields: [batchId], references: [id])
  actor   User?           @relation("PharmacyStockActor", fields: [actorUserId], references: [id])

  @@index([clinicId, createdAt])
  @@index([clinicId, productId])
  @@index([clinicId, batchId])
  @@index([referenceType, referenceId])
}

model PharmacyPurchaseOrder {
  id               String                      @id @default(cuid())
  clinicId         String
  supplierId       String
  orderNumber      String
  orderDate        DateTime                    @default(now())
  expectedDelivery DateTime?
  status           PharmacyPurchaseOrderStatus @default(DRAFT)
  taxAmount        Decimal                     @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal                     @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  clinic   Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  supplier PharmacySupplier            @relation(fields: [supplierId], references: [id])
  items    PharmacyPurchaseOrderItem[]

  @@unique([clinicId, orderNumber])
  @@index([clinicId, status])
  @@index([clinicId, supplierId])
}

model PharmacyPurchaseOrderItem {
  id               String    @id @default(cuid())
  purchaseOrderId  String
  productId        String
  batchId          String?
  quantityOrdered  Int
  quantityReceived Int       @default(0)
  purchasePrice    Decimal   @default(0) @db.Decimal(12, 2)
  mrp              Decimal   @default(0) @db.Decimal(12, 2)
  batchNumber      String?
  expiryDate       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  purchaseOrder PharmacyPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       PharmacyProduct       @relation(fields: [productId], references: [id])
  batch         PharmacyBatch?        @relation(fields: [batchId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model PharmacySale {
  id             String                    @id @default(cuid())
  clinicId       String
  invoiceNumber  String
  patientId      String?
  coupleId       String?
  doctorName     String?
  subtotal       Decimal                   @default(0) @db.Decimal(12, 2)
  discountAmount Decimal                   @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal                   @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal                   @default(0) @db.Decimal(12, 2)
  paymentMethod  PharmacySalePaymentMethod @default(CASH)
  paymentStatus  PharmacySalePaymentStatus @default(PAID)
  notes          String?
  createdById    String?
  soldAt         DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  clinic    Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient?           @relation(fields: [patientId], references: [id])
  couple    Couple?            @relation(fields: [coupleId], references: [id])
  createdBy User?              @relation("PharmacySaleCreator", fields: [createdById], references: [id])
  items     PharmacySaleItem[]
  billingInvoice BillingInvoice?
  billingPayments BillingPayment[]

  @@unique([clinicId, invoiceNumber])
  @@index([clinicId, soldAt])
  @@index([clinicId, patientId])
  @@index([clinicId, coupleId])
}

model PharmacySaleItem {
  id             String   @id @default(cuid())
  saleId         String
  productId      String
  batchId        String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  sale    PharmacySale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product PharmacyProduct @relation(fields: [productId], references: [id])
  batch   PharmacyBatch   @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
}

model PharmacyPrescription {
  id               String                     @id @default(cuid())
  clinicId         String
  patientId        String
  coupleId         String?
  doctorId         String?
  doctorName       String?
  appointmentId    String?
  treatmentId      String?
  prescriptionDate DateTime                   @default(now())
  status           PharmacyPrescriptionStatus @default(PENDING)
  notes            String?
  dispensedById    String?
  dispensedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  clinic      Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient                    @relation(fields: [patientId], references: [id])
  couple      Couple?                    @relation(fields: [coupleId], references: [id])
  doctor      User?                      @relation("PharmacyPrescriptionDoctor", fields: [doctorId], references: [id])
  dispensedBy User?                      @relation("PharmacyPrescriptionDispenser", fields: [dispensedById], references: [id])
  appointment Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  treatment   Treatment?                 @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  items       PharmacyPrescriptionItem[]

  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([clinicId, coupleId])
  @@index([clinicId, prescriptionDate])
  @@index([appointmentId])
  @@index([treatmentId])
}

model PharmacyPrescriptionItem {
  id                 String    @id @default(cuid())
  prescriptionId     String
  productId          String
  batchId            String?
  medicineName       String
  dosage             String?
  frequency          String?
  duration           String?
  route              String?
  instructions       String?
  timeOfDay          String?
  beforeAfterFood    String?
  startDate          DateTime?
  endDate            DateTime?
  quantityPrescribed Int
  quantityDispensed  Int       @default(0)
  careTaskId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  prescription PharmacyPrescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product      PharmacyProduct       @relation(fields: [productId], references: [id])
  batch        PharmacyBatch?        @relation(fields: [batchId], references: [id])
  careTask     CareTask?             @relation(fields: [careTaskId], references: [id], onDelete: SetNull)
  reminders    MedicationReminder[]

  @@index([prescriptionId])
  @@index([productId])
  @@index([careTaskId])
}

model MedicationReminder {
  id                 String                   @id @default(cuid())
  clinicId           String
  prescriptionItemId String
  patientId          String
  careTaskId         String?
  scheduledAt        DateTime
  status             MedicationReminderStatus @default(SCHEDULED)
  channel            ConversationChannel      @default(WHATSAPP)
  demoMode           Boolean                  @default(true)
  demoMessageBody    String?
  failureReason      String?
  sentAt             DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  clinic           Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prescriptionItem PharmacyPrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  patient          Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  careTask         CareTask?                @relation(fields: [careTaskId], references: [id], onDelete: SetNull)

  @@index([clinicId, scheduledAt, status])
  @@index([prescriptionItemId])
  @@index([patientId, scheduledAt])
  @@index([careTaskId])
}

// ─── Insurance & Claims ──────────────────────────────────────────────────────

enum InsurancePolicyStatus {
  ACTIVE
  EXPIRED
  PENDING_VERIFICATION
  CANCELLED
}

enum InsuranceEligibilityStatus {
  PENDING
  VERIFIED
  NOT_VERIFIED
  FAILED
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUERY
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  FINAL_BILL_PENDING
  PAYMENT_PENDING
  PAID
  CLOSED
}

enum InsuranceClaimType {
  CASHLESS
  REIMBURSEMENT
  PRE_AUTH
}

enum InsuranceQueryStatus {
  OPEN
  RESPONDED
  RESOLVED
  OVERDUE
}

enum InsuranceIntegrationMode {
  MANUAL_DEMO
  NHCX_NOT_CONNECTED
}

model InsuranceProvider {
  id              String                   @id @default(cuid())
  clinicId        String
  name            String
  logoUrl         String?
  supportContact  String?
  supportEmail    String?
  supportPhone    String?
  notes           String?
  isActive        Boolean                  @default(true)
  integrationMode InsuranceIntegrationMode @default(MANUAL_DEMO)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  clinic   Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  policies InsurancePolicy[]
  claims   InsuranceClaim[]

  @@index([clinicId, isActive])
  @@index([clinicId, name])
}

model InsuranceTpa {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  contact   String?
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic   Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  policies InsurancePolicy[]
  claims   InsuranceClaim[]

  @@index([clinicId, isActive])
  @@index([clinicId, name])
}

model InsurancePolicy {
  id                   String                     @id @default(cuid())
  clinicId             String
  patientId            String
  coupleId             String?
  providerId           String
  tpaId                String?
  policyName           String
  policyNumber         String
  memberId             String?
  policyHolderName     String?
  relationshipToHolder String?
  startDate            DateTime?
  expiryDate           DateTime?
  sumInsured           Decimal                    @default(0) @db.Decimal(14, 2)
  availableCoverage    Decimal                    @default(0) @db.Decimal(14, 2)
  networkStatus        String?
  cashlessStatus       String?
  status               InsurancePolicyStatus      @default(PENDING_VERIFICATION)
  eligibilityStatus    InsuranceEligibilityStatus @default(PENDING)
  notes                String?
  cardDocumentId       String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id])
  couple       Couple?           @relation(fields: [coupleId], references: [id])
  provider     InsuranceProvider @relation(fields: [providerId], references: [id])
  tpa          InsuranceTpa?     @relation(fields: [tpaId], references: [id])
  cardDocument Document?         @relation("InsuranceCardDocument", fields: [cardDocumentId], references: [id])
  claims       InsuranceClaim[]

  @@unique([clinicId, policyNumber])
  @@index([clinicId, patientId])
  @@index([clinicId, coupleId])
  @@index([clinicId, status])
  @@index([providerId])
  @@index([tpaId])
}

model InsuranceClaim {
  id                    String               @id @default(cuid())
  clinicId              String
  claimNumber           String
  patientId             String
  coupleId              String?
  policyId              String
  providerId            String
  tpaId                 String?
  claimType             InsuranceClaimType   @default(PRE_AUTH)
  status                InsuranceClaimStatus @default(DRAFT)
  treatmentLabel        String?
  procedureLabel        String?
  diagnosisCategory     String?
  expectedAdmissionDate DateTime?
  expectedDischargeDate DateTime?
  doctorName            String?
  assignedCoordinatorId String?
  amountRequested       Decimal              @default(0) @db.Decimal(14, 2)
  amountApproved        Decimal              @default(0) @db.Decimal(14, 2)
  amountRejected        Decimal              @default(0) @db.Decimal(14, 2)
  amountPaid            Decimal              @default(0) @db.Decimal(14, 2)
  patientResponsibility Decimal              @default(0) @db.Decimal(14, 2)
  priority              String               @default("NORMAL")
  dueDate               DateTime?
  notes                 String?
  preauthSubmittedAt    DateTime?
  closedAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  clinic              Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient             Patient                  @relation("InsuranceClaimPatient", fields: [patientId], references: [id])
  couple              Couple?                  @relation(fields: [coupleId], references: [id])
  policy              InsurancePolicy          @relation(fields: [policyId], references: [id])
  provider            InsuranceProvider        @relation(fields: [providerId], references: [id])
  tpa                 InsuranceTpa?            @relation(fields: [tpaId], references: [id])
  assignedCoordinator User?                    @relation("InsuranceClaimAssignee", fields: [assignedCoordinatorId], references: [id])
  documents           InsuranceClaimDocument[]
  queries             InsuranceQuery[]
  payments            InsurancePayment[]
  events              InsuranceClaimEvent[]

  @@unique([clinicId, claimNumber])
  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([clinicId, coupleId])
  @@index([clinicId, updatedAt])
  @@index([policyId])
  @@index([assignedCoordinatorId])
}

model InsuranceClaimDocument {
  id           String   @id @default(cuid())
  claimId      String
  documentId   String
  documentType String?
  notes        String?
  createdAt    DateTime @default(now())

  claim    InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id])

  @@unique([claimId, documentId])
  @@index([claimId])
  @@index([documentId])
}

model InsuranceQuery {
  id              String               @id @default(cuid())
  clinicId        String
  claimId         String
  careTaskId      String?
  message         String
  receivedAt      DateTime             @default(now())
  dueDate         DateTime?
  status          InsuranceQueryStatus @default(OPEN)
  assignedToId    String?
  responseMessage String?
  respondedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  clinic     Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  claim      InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  careTask   CareTask?      @relation(fields: [careTaskId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("InsuranceQueryAssignee", fields: [assignedToId], references: [id])

  @@index([clinicId, status])
  @@index([claimId])
  @@index([careTaskId])
  @@index([assignedToId])
}

model InsurancePayment {
  id            String   @id @default(cuid())
  clinicId      String
  claimId       String
  amount        Decimal  @db.Decimal(14, 2)
  paymentDate   DateTime @default(now())
  paymentMethod String?
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())

  clinic Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  claim  InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([clinicId, claimId])
  @@index([claimId])
}

model InsuranceClaimEvent {
  id        String   @id @default(cuid())
  clinicId  String
  claimId   String
  action    String
  status    String?
  note      String?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  clinic Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  claim  InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([clinicId, claimId, createdAt])
  @@index([claimId])
}

// ─── Billing & Payment Gateways ──────────────────────────────────────────────

enum PaymentGatewayProvider {
  RAZORPAY
  CASHFREE
  PAYU
}

enum PaymentGatewayMode {
  TEST
  LIVE
}

enum PaymentGatewayConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum BillingInvoiceSource {
  TREATMENT
  PHARMACY
  MANUAL
  OTHER
}

enum BillingInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillingPaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BillingPaymentProvider {
  RAZORPAY
  CASHFREE
  PAYU
  MANUAL
  CASH
}

enum BillingRefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model PaymentGatewayConnection {
  id                     String                         @id @default(cuid())
  clinicId               String
  provider               PaymentGatewayProvider
  displayName            String?
  encryptedCredentials   String?
  mode                   PaymentGatewayMode             @default(TEST)
  status                 PaymentGatewayConnectionStatus @default(DISCONNECTED)
  isDefault              Boolean                        @default(false)
  isActive               Boolean                        @default(false)
  lastTestedAt           DateTime?
  lastError              String?
  webhookSecretEncrypted String?
  config                 Json?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  clinic   Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  payments BillingPayment[]

  @@unique([clinicId, provider])
  @@index([clinicId, isActive])
  @@index([clinicId, isDefault])
}

model BillingInvoice {
  id              String               @id @default(cuid())
  clinicId        String
  invoiceNumber   String
  patientId       String?
  coupleId        String?
  pharmacySaleId  String?              @unique
  source          BillingInvoiceSource @default(MANUAL)
  title           String
  description     String?
  currency        String               @default("INR")
  totalAmount     Decimal              @db.Decimal(14, 2)
  paidAmount      Decimal              @default(0) @db.Decimal(14, 2)
  status          BillingInvoiceStatus @default(ISSUED)
  dueDate         DateTime?
  issuedAt        DateTime             @default(now())
  paidAt          DateTime?
  notes           String?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient?             @relation(fields: [patientId], references: [id])
  couple       Couple?              @relation(fields: [coupleId], references: [id])
  pharmacySale PharmacySale?        @relation(fields: [pharmacySaleId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("BillingInvoiceCreator", fields: [createdById], references: [id])
  lines        BillingInvoiceLine[]
  payments     BillingPayment[]

  @@unique([clinicId, invoiceNumber])
  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([clinicId, coupleId])
  @@index([clinicId, dueDate])
  @@index([clinicId, issuedAt])
}

model BillingInvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitAmount  Decimal  @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model BillingPayment {
  id                   String                 @id @default(cuid())
  clinicId             String
  invoiceId            String?
  patientId            String?
  coupleId             String?
  pharmacySaleId       String?
  gatewayConnectionId  String?
  provider             BillingPaymentProvider
  amount               Decimal                @db.Decimal(14, 2)
  currency             String                 @default("INR")
  status               BillingPaymentStatus   @default(PENDING)
  method               String?
  gatewayOrderId       String?
  gatewayPaymentId     String?
  gatewayReference     String?
  paymentLinkUrl       String?
  paymentLinkId        String?
  failureReason        String?
  metadata             Json?
  paidAt               DateTime?
  createdById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  clinic            Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoice           BillingInvoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  patient           Patient?                   @relation(fields: [patientId], references: [id])
  couple            Couple?                    @relation(fields: [coupleId], references: [id])
  pharmacySale      PharmacySale?              @relation(fields: [pharmacySaleId], references: [id], onDelete: SetNull)
  gatewayConnection PaymentGatewayConnection?  @relation(fields: [gatewayConnectionId], references: [id], onDelete: SetNull)
  createdBy         User?                      @relation("BillingPaymentCreator", fields: [createdById], references: [id])
  refunds           BillingRefund[]

  @@index([clinicId, status])
  @@index([clinicId, createdAt])
  @@index([invoiceId])
  @@index([patientId])
  @@index([coupleId])
  @@index([pharmacySaleId])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([paymentLinkId])
  @@unique([clinicId, gatewayPaymentId])
}

model BillingRefund {
  id              String              @id @default(cuid())
  clinicId        String
  paymentId       String
  amount          Decimal             @db.Decimal(14, 2)
  currency        String              @default("INR")
  status          BillingRefundStatus @default(PENDING)
  reason          String?
  gatewayRefundId String?
  failureReason   String?
  createdById     String?
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  payment   BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("BillingRefundCreator", fields: [createdById], references: [id])

  @@index([clinicId, paymentId])
  @@index([paymentId])
  @@index([gatewayRefundId])
}

model PaymentWebhookEvent {
  id              String   @id @default(cuid())
  clinicId        String?
  provider        PaymentGatewayProvider
  externalEventId String
  eventType       String
  paymentId       String?
  processed       Boolean  @default(false)
  payloadHash     String?
  error           String?
  receivedAt      DateTime @default(now())
  processedAt     DateTime?

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([clinicId, receivedAt])
  @@index([paymentId])
}

// ─── WhatsApp Automation Center (Flows + KB) ─────────────────────────────────

enum WhatsAppFlowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WhatsAppFlowExecutionStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
  ESCALATED
}

enum WhatsAppFlowStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum WhatsAppKnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model WhatsAppFlow {
  id              String            @id @default(cuid())
  clinicId        String
  name            String
  description     String?
  status          WhatsAppFlowStatus @default(DRAFT)
  triggerType     String
  /// JSON graph: { nodes: FlowNode[], edges: FlowEdge[] }
  definition      Json
  isLibrary       Boolean           @default(false)
  libraryKey      String?
  createdById     String?
  lastRunAt       DateTime?
  successCount    Int               @default(0)
  failureCount    Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  clinic     Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy  User?                   @relation("WhatsAppFlowCreator", fields: [createdById], references: [id])
  executions WhatsAppFlowExecution[]

  @@index([clinicId, status])
  @@index([clinicId, triggerType])
  @@index([clinicId, libraryKey])
}

model WhatsAppFlowExecution {
  id               String                      @id @default(cuid())
  clinicId         String
  flowId           String
  status           WhatsAppFlowExecutionStatus @default(PENDING)
  triggerType      String
  triggerEventId   String?
  idempotencyKey   String
  patientId        String?
  coupleId         String?
  conversationId   String?
  currentNodeId    String?
  context          Json?
  error            String?
  resumeAt         DateTime?
  startedAt        DateTime                    @default(now())
  completedAt      DateTime?
  updatedAt        DateTime                    @updatedAt

  clinic Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  flow   WhatsAppFlow              @relation(fields: [flowId], references: [id], onDelete: Cascade)
  steps  WhatsAppFlowExecutionStep[]

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, status])
  @@index([flowId, status])
  @@index([clinicId, resumeAt])
  @@index([patientId])
  @@index([conversationId])
}

model WhatsAppFlowExecutionStep {
  id          String                 @id @default(cuid())
  executionId String
  nodeId      String
  nodeType    String
  status      WhatsAppFlowStepStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime               @default(now())

  execution WhatsAppFlowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model WhatsAppKnowledgeArticle {
  id          String                  @id @default(cuid())
  clinicId    String
  title       String
  category    String
  content     String
  /// Comma-separated or free-text keywords for search / AI retrieval hints
  keywords    String?
  /// Optional specialty pack label (FERTILITY, DENTAL, DERMATOLOGY, MATERNITY, AESTHETICS, GENERAL, CUSTOM)
  specialty   String?
  status      WhatsAppKnowledgeStatus @default(DRAFT)
  updatedById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation("WhatsAppKbAuthor", fields: [updatedById], references: [id])

  @@index([clinicId, status])
  @@index([clinicId, category])
  @@index([clinicId, specialty])
}

/// Clinic WhatsApp communication safety settings (working hours, frequency, consent mode).
model WhatsAppClinicSettings {
  id                     String   @id @default(cuid())
  clinicId               String   @unique
  /// Json map of weekday → { start: "HH:mm", end: "HH:mm" } | null (closed)
  workingHours           Json?
  timezone               String   @default("Asia/Kolkata")
  maxMessagesPerDay      Int      @default(5)
  minDelayMinutes        Int      @default(30)
  /// When true, automation SEND requires Consent GRANTED (not merely "not revoked")
  requireConsentGranted  Boolean  @default(false)
  /// When true, ESCALATE / urgent path may bypass working-hours wait
  urgentBypassHours      Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

/// Per-patient channel / reminder preferences (clinical vs marketing separated).
model CommunicationPreference {
  id                    String   @id @default(cuid())
  clinicId              String
  patientId             String   @unique
  whatsappEnabled       Boolean  @default(true)
  smsEnabled            Boolean  @default(false)
  emailEnabled          Boolean  @default(false)
  phoneEnabled          Boolean  @default(true)
  /// Marketing / promotional (separate from clinical ops)
  marketingOptIn        Boolean  @default(false)
  appointmentReminders  Boolean  @default(true)
  careReminders         Boolean  @default(true)
  paymentReminders      Boolean  @default(true)
  pharmacyReminders     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

enum WhatsAppCampaignStatus {
  DRAFT
  READY
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

/// Controlled WhatsApp broadcast (template-only, consent-gated).
model WhatsAppCampaign {
  id                 String                 @id @default(cuid())
  clinicId           String
  name               String
  status             WhatsAppCampaignStatus @default(DRAFT)
  templateName       String
  templateLanguage   String                 @default("en")
  templateId         String?
  /// Audience filter Json (status, inactiveDays, specialty, etc.)
  audienceFilter     Json?
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  confirmedAt        DateTime?
  createdById        String?
  audienceCount      Int                    @default(0)
  eligibleCount      Int                    @default(0)
  excludedCount      Int                    @default(0)
  sentCount          Int                    @default(0)
  deliveredCount     Int                    @default(0)
  readCount          Int                    @default(0)
  failedCount        Int                    @default(0)
  repliedCount       Int                    @default(0)
  skippedCount       Int                    @default(0)
  lastError          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  clinic    Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy User?                      @relation("WhatsAppCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipients WhatsAppCampaignRecipient[]

  @@index([clinicId, status])
  @@index([clinicId, scheduledAt])
}

model WhatsAppCampaignRecipient {
  id           String   @id @default(cuid())
  campaignId   String
  patientId    String
  clinicId     String
  status       String   @default("PENDING")
  skipReason   String?
  messageId    String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patient  Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([campaignId, patientId])
  @@index([campaignId, status])
  @@index([clinicId])
}

// ─── Stage 7: Digital Health / ABHA / ABDM foundation ─────────────────────────

enum AbhaLinkStatus {
  NOT_LINKED
  PENDING
  LINKED
  VERIFICATION_REQUIRED
  ERROR
}

enum DigitalHealthConsentStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  REJECTED
}

enum HealthRecordExchangeStatus {
  DRAFT
  CONSENT_REQUIRED
  CONSENT_GRANTED
  PREPARING
  PREPARED
  SHARING
  SHARED
  FAILED
  EXPIRED
  REVOKED
}

/// Clinic-scoped ABHA / digital health identity link for a SMRKOMED patient.
/// Does not replace Patient. Messaging Consent remains separate.
model DigitalHealthIdentity {
  id                 String         @id @default(cuid())
  clinicId           String
  patientId          String         @unique
  /// SHA-256 of normalized ABHA digits — for uniqueness; never log raw ABHA.
  abhaNumberHash     String?
  /// Masked display only, e.g. XX-XXXX-XXXX-1234
  abhaMasked         String?
  abhaAddress        String?
  status             AbhaLinkStatus @default(NOT_LINKED)
  verificationStatus String?
  linkedAt           DateTime?
  lastVerifiedAt     DateTime?
  /// DEMO_SEED | LINK_INTENT | ABDM_GATEWAY
  source             String?
  sandboxMode        Boolean        @default(true)
  errorMessage       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, abhaNumberHash])
  @@index([clinicId, status])
}

/// ABDM-oriented health-information consent (not WhatsApp/SMS Consent).
model DigitalHealthConsent {
  id                String                      @id @default(cuid())
  clinicId          String
  patientId         String
  purpose           String
  requestedById     String?
  requestedByName   String?
  requestedAt       DateTime                    @default(now())
  expiresAt         DateTime?
  /// JSON string array of categories, e.g. ["Prescription","Consultation"]
  dataCategories    Json
  status            DigitalHealthConsentStatus  @default(PENDING)
  externalConsentId String?
  careTaskId        String?
  notes             String?
  decidedAt         DateTime?
  sandboxMode       Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  clinic      Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy User?                @relation("DigitalHealthConsentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  exchanges   HealthRecordExchange[]

  @@index([clinicId, status])
  @@index([patientId, status])
  @@index([clinicId, expiresAt])
}

/// Prepare / share lifecycle for interoperability. SHARED only after provider confirms.
model HealthRecordExchange {
  id                  String                     @id @default(cuid())
  clinicId            String
  patientId           String
  consentId           String?
  status              HealthRecordExchangeStatus @default(DRAFT)
  purpose             String
  recordTypes         Json
  dateFrom            DateTime?
  dateTo              DateTime?
  receivingEntity     String?
  /// Interoperability DTO snapshot (SMRKOMED → mapped resources). Not claimed ABDM-compliant.
  preparedPayload     Json?
  idempotencyKey      String
  externalReferenceId String?
  failureReason       String?
  sandboxMode         Boolean                    @default(true)
  createdById         String?
  preparedAt          DateTime?
  sharedAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  clinic    Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consent   DigitalHealthConsent? @relation(fields: [consentId], references: [id], onDelete: SetNull)
  createdBy User?                 @relation("HealthRecordExchangeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, status])
  @@index([patientId, status])
}
