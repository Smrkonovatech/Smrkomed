# SmrkoMed Admin Portal — local environment
# Copied from the repository root `.env` by `npm run dev:admin`.
# Do not commit secrets. Do not prefix AUTH_SECRET with NEXT_PUBLIC_.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000

# Auth.js for this app must use the admin origin (not apps/web on :3000).
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true
DATABASE_URL="postgresql://smrkomed:smrkomed@localhost:5432/smrkomed?schema=public"
