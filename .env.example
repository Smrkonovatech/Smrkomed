# SmrkoMed — environment placeholders (never commit real secrets)
# Keep this file at the repository root. `npm run dev` / `build` / `start`
# copy it into apps/web/.env so Next.js and Auth.js can read it.
# The shared Prisma client in packages/database also loads this file.
# Do not commit `.env`.
# DATABASE_URL is server-only — never expose it to the browser.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://smrkomed:smrkomed@localhost:5432/smrkomed?schema=public"
DIRECT_URL="postgresql://smrkomed:smrkomed@localhost:5432/smrkomed?schema=public"

# Auth.js (required on Vercel — missing AUTH_SECRET shows "Server error")
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Integration Framework — server-only AES-256-GCM key. Never NEXT_PUBLIC_.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
MOCK_INTEGRATIONS_ENABLED=

# Payment gateways — clinic merchant credentials are stored encrypted per clinic
# (PaymentGatewayConnection.encryptedCredentials). Do NOT put clinic Key Secret /
# Merchant Salt in NEXT_PUBLIC_* or commit them here.
# Platform-level optional:
# PAYMENTS_MOCK=1 forces sandbox mock adapters (no live gateway calls) for local/dev tests.
PAYMENTS_MOCK=

# Webhook URLs (configure in each gateway dashboard; clinic webhook secrets stored encrypted):
# POST {API_URL}/api/v1/payments/webhooks/razorpay
# POST {API_URL}/api/v1/payments/webhooks/cashfree
# POST {API_URL}/api/v1/payments/webhooks/payu
#
# Clinic-level credentials (entered in Settings → Payments, encrypted at rest):
# Razorpay: Key ID + Key Secret (+ optional Webhook Secret)
# Cashfree: App ID + Secret Key (+ optional Webhook Secret)
# PayU: Merchant Key + Merchant Salt (+ optional Webhook Secret)

# WhatsApp Business Platform (Phase 7) — server-only Meta application credentials.
# Clinic WhatsApp tokens are obtained via Embedded Signup and stored encrypted. Do not paste clinic tokens.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_CONFIGURATION_ID=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# WhatsApp Automation worker (Railway API long-running process)
# WHATSAPP_AUTOMATION_WORKER=1 enables in-process tick in any env (default on when NODE_ENV=production)
# WHATSAPP_AUTOMATION_WORKER=0 disables even in production
# WHATSAPP_AUTOMATION_WORKER_INTERVAL_MS=60000
# Shared secret for cron/Vercel → POST /api/v1/whatsapp-automation/internal/tick
# Header: X-WhatsApp-Worker-Secret: <value>
WHATSAPP_WORKER_SECRET=
# CRON_SECRET=   # alternate name also accepted

# Optional browser identifiers for Embedded Signup. Prefer loading these from the authenticated
# /api/v1/integrations/whatsapp/connect response. Never expose META_APP_SECRET here.
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_WHATSAPP_CONFIGURATION_ID=

# OpenAI — Smrko AI Buddy + Voice Notes (server-side only; never NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ABDM / ABHA — server-only. Never NEXT_PUBLIC_.
# Leave unset → Digital Health works locally; live gateway ops return NOT CONNECTED.
# ABDM_ENABLED=1
# ABDM_ENV=sandbox
# ABDM_BASE_URL=
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# ABDM_FACILITY_ID=
# ABDM_X_CM_ID=
# ABDM_DEMO_MODE=1 allows SANDBOX local link intents only (never claims OTP/gateway success)
ABDM_ENABLED=
ABDM_ENV=sandbox
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_FACILITY_ID=
ABDM_X_CM_ID=
ABDM_DEMO_MODE=

# Object storage (Phase 2+)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Legacy aliases (optional)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Voice (Phase 6+)
VOICE_API_KEY=

# Observability
SENTRY_DSN=
