# SmrkoMed API — local environment (never commit real secrets)
# Copy values from the repository root `.env`. The API also loads the root file automatically.

DATABASE_URL="postgresql://smrkomed:smrkomed@localhost:5432/smrkomed?schema=public"
DIRECT_URL="postgresql://smrkomed:smrkomed@localhost:5432/smrkomed?schema=public"

# Must match apps/web Auth.js so session cookies can be verified.
AUTH_SECRET="replace-with-a-long-random-string"

WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Comma-separated. Do not use * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Set to 1 in tests. In-memory limiter is a development placeholder (no Redis yet).
# Distributed rate limiting will be introduced with Redis later. Webhooks use a stricter in-memory bucket.
RATE_LIMIT_DISABLED=

# AES-256-GCM key for integration credentials (32 bytes). Never prefix with NEXT_PUBLIC_.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# Enables the mock provider in local development. Ignored in production. Tests register the mock explicitly.
MOCK_INTEGRATIONS_ENABLED=

# WhatsApp Business Platform / Cloud API (server-only). Never prefix with NEXT_PUBLIC_.
# Required for Embedded Signup and webhooks. Do not paste clinic access tokens here.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_CONFIGURATION_ID=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
